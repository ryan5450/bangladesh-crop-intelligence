# ==============================================================================
# Bangladesh Crop Intelligence API - Backend Environment Variables
# Copy this file to `.env` and fill in your actual credentials.
# ==============================================================================

# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_or_service_role_key

# Free Cloud LLM (Groq) - Recommended for 24/7 Free Cloud Deployment
# Obtain free API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Local Ollama LLM Configuration (Used automatically if GROQ_API_KEY is empty)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120.0

# CORS Allowed Origins (comma-separated, include your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-app.vercel.app
