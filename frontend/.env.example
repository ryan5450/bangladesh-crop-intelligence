# ==============================================================================
# Bangladesh Crop Intelligence Frontend - Environment Variables
# Copy this file to `.env.local` and customize for your environment.
# ==============================================================================

# FastAPI Backend REST API Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase Credentials (Optional for client-side direct queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
