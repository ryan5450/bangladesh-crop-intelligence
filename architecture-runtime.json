  "cards": [
    {
      "dot": "emerald",
      "title": "Presentation & Interaction Layer",
      "items": [
        "Next.js 14 App Router, TypeScript, Tailwind CSS, and Framer Motion",
        "Public Portal: Crop Explorer, Detail Views, and Search/Filter Engine",
        "AI Assistant: Continuous Web Speech API with 3.0s silence debounce",
        "Admin Dashboard: Role-Based Access Control console for crop management"
      ]
    },
    {
      "dot": "cyan",
      "title": "FastAPI Microservices & ETL Pipeline",
      "items": [
        "FastAPI Gateway: REST routing, Pydantic validation, CORS, and auth middleware",
        "Crop Service: High-speed taxonomy retrieval for 25 crops & 139 BRRI varieties",
        "RAG Orchestrator: Multi-turn dialog buffer (8 turns) & English-default directives",
        "Crawler Service & Doc Processor: Ingests BRRI/BARI/DAE PDFs with OCR and classification"
      ]
    },
    {
      "dot": "amber",
      "title": "AI, RAG & Cloud Persistence Tier",
      "items": [
        "ChromaDB / pgvector: 24,178 dense vectors generated with BAAI bge-m3 embeddings",
        "Local Ollama Daemon: Qwen 2.5 3B / Llama 3.1 delivering token-streamed responses",
        "Supabase PostgreSQL: Relational tables for crops, stages, diseases, and regions",
        "Supabase Storage: Media buckets for crop photography and archived PDF guides"
      ]
    }
  ]
